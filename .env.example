# Secreto compartido con el PSP para firmar webhooks
WEBHOOK_SECRET=cambiar-por-un-secreto-largo
# API key del comercio de prueba m_001 (la usa el seed y scripts/enviar-secuencia.mjs)
MERCHANT_API_KEY=mk_test_m001_cambiar
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledger

# Puerto HTTP de la API
PORT=3000
LOG_LEVEL=info
# Ventana anti-replay del webhook, en segundos (5 minutos)
WEBHOOK_TOLERANCIA_SEG=300
# Comercio sembrado al arrancar; comisión en puntos básicos (250 = 2,5 %)
SEED_MERCHANT_ID=m_001
SEED_COMMISSION_BPS=250
# Conexiones a Postgres por proceso
API_DB_POOL_SIZE=20
WORKER_DB_POOL_SIZE=10
# Cantidad de loops de procesamiento en paralelo dentro del worker
WORKER_CONCURRENCIA=8
# Intentos antes de marcar un evento como failed
WORKER_MAX_INTENTOS=5
# Token para los endpoints /admin (header x-admin-token)
ADMIN_TOKEN=cambiar-token-admin
